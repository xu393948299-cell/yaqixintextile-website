{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/(?:scripts|docs)(?:/.*)?$",
      "status": 404
    },
    {
      "src": "^/DEPLOYMENT-STEPS\\.md$",
      "status": 404
    },
    {
      "src": "^/blog/README\\.md$",
      "status": 404
    },
    {
      "src": "^/blog/content/articles\\.json$",
      "status": 404
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/GG-optimized-v9-denim-seo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/custom-capability",
      "permanent": true
    },
    {
      "source": "/blog/index",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/content/how-to-source-wholesale-fabric-from-china",
      "destination": "/blog/how-to-source-wholesale-fabric-from-china",
      "permanent": true
    },
    {
      "source": "/blog/content/how-to-choose-tulle-fabric-for-wedding-dresses-veils-and-dancewear",
      "destination": "/blog/how-to-choose-tulle-fabric-for-wedding-dresses-veils-and-dancewear",
      "permanent": true
    },
    {
      "source": "/blog/:slug/index",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/es/index",
      "destination": "/es",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/yaqixin-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/blog/content/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self' https://formsubmit.co; img-src 'self' data: https:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://formsubmit.co https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; font-src 'self' data: https:; worker-src 'self' blob:;"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
